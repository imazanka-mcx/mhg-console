# Copy to .env and fill in. Never commit .env.
#
# Two URLs because Neon pools connections: DATABASE_URL is the pooled endpoint
# the app runs on, DIRECT_URL the non-pooled one Prisma needs for migrations.
# Same split Inspire uses (mhotels-inspire/DEPLOY.md).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/mhg_console?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/mhg_console?sslmode=require"

# Local development against a throwaway Postgres, e.g.:
# DATABASE_URL="postgresql://postgres@localhost:5432/console_dev"
# DIRECT_URL="postgresql://postgres@localhost:5432/console_dev"
