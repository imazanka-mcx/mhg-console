// MHG Corporate Console — the registry plane (docs/01 §1).
//
// Two tables carry the Inn Code Standard's uniqueness guarantee, and the split
// between them is the whole point:
//
//   property   — one row per hotel, keyed on the immutable internal id the
//                engine mints. Holds the CURRENT record. A rebrand (G2) updates
//                this row in place, so downstream systems never repoint (G1).
//   inn_code   — one row per code EVER ISSUED, keyed on the code itself. Rows
//                are never deleted, so M5 and G3 fire against history and not
//                just the live portfolio. A rebrand adds a row; it removes none.
//
// Firestore needed four collections for this because it cannot enforce
// uniqueness on a field — the code and the market code had to become document
// ids, and the submarket reverse-index had to be its own collection. Postgres
// enforces on fields, so `submarket_index` collapses into a nullable unique
// column on market_claim (NULLs do not collide, which is exactly the semantics
// M6 wants: base market codes bind no submarket).
//
// G8: the registry is the source of truth, not the formula. Here that is not a
// convention — `inn_code.code` is a primary key and `market_claim.submarket_key`
// is a unique index, so a duplicate is a constraint violation the database
// refuses, not a check a code path can forget to run.

generator client {
  provider = "prisma-client-js"
  // `native` is whatever machine ran `prisma generate` — a Mac here. Vercel's
  // Node 22 runtime is Amazon Linux 2023, which needs the rhel-openssl-3.0.x
  // engine; without it the deployed app throws at the first query rather than
  // at build, which is the worst place to find out.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Mirrors PropertyStatus in @mcx/inn-code. Retired codes stay claimed forever (G3).
enum PropertyStatus {
  pipeline
  active
  retired
}

/// Mirrors MarketSource in @mcx/inn-code — records WHICH rung of the M ladder
/// produced a code, so M7 ("never reassigned") can be audited later.
enum MarketSource {
  override
  metro
  airport
  letters
  submarket
  registered

  @@map("market_source")
}

/// The hotel. `id` is the engine's propertyId: immutable, never the inn code (G1).
model Property {
  id String @id

  /// The code this property flies today. Unique across live properties; the
  /// full historical guarantee lives on InnCode.
  code String @unique

  name            String
  brandCode       String         @map("brand_code")
  brandName       String         @map("brand_name")
  chainCode       String         @map("chain_code")
  marketCode      String         @map("market_code")
  city            String
  state           String
  submarket       String         @default("")
  /// Cross-reference only, never an identifier here (G5).
  franchisorCode  String         @default("") @map("franchisor_code")
  status          PropertyStatus
  /// Set when this property's code replaced another on a rebrand (G2).
  predecessorCode String         @default("") @map("predecessor_code")
  /// Date the code was issued, not the opening date. Held as the engine holds
  /// it — a YYYY-MM-DD string — so a round trip cannot shift it across a zone.
  effectiveDate   String         @map("effective_date")
  propCode        String         @map("prop_code")

  // ── Shell fields the engine does not know about (docs/01 §1.3) ──────────
  // The Inn Code engine issues identity from name, place and flag. A consumer
  // standing the hotel up also needs to know what clock and what money it runs
  // on, so those ride on the property here rather than in the engine.

  /// IANA zone. Defaults to Eastern so the two pre-shell rows backfill to a
  /// real value; the New Property form asks for it explicitly.
  timezone         String  @default("America/New_York")
  /// ISO 4217.
  currency         String  @default("USD")
  /// Planned opening, YYYY-MM-DD. Empty when not yet known. Distinct from
  /// effectiveDate, which is when the CODE was issued (G6), not the hotel.
  expectedOpenDate String  @default("") @map("expected_open_date")

  /// Bumped on every change a consumer must hear about. Consumers apply a
  /// shell only if its version is newer than the one they hold, which is what
  /// makes delivery idempotent and safe to repeat (§1.4).
  shellVersion     Int     @default(0) @map("shell_version")

  // ── The asset and its compliance (docs/01 §1.7) ─────────────────────────
  // Console-only: none of these are in the shell and none bump shellVersion.
  // They describe the building the portfolio holds, not how a stay runs —
  // room types and inventory stay in Inspire.

  streetAddress    String  @default("") @map("street_address")
  postalCode       String  @default("") @map("postal_code")
  /// Rentable keys. The number fees, standards tiers and rules key off.
  keyCount         Int?    @map("key_count")
  /// One of SERVICE_LEVELS in src/orgs/rules.ts, or '' while unknown.
  serviceLevel     String  @default("") @map("service_level")
  yearOpened       Int?    @map("year_opened")
  yearRenovated    Int?    @map("year_renovated")
  /// none | scheduled | in_progress | complete
  pipStatus        String  @default("none") @map("pip_status")
  pipDueDate       String  @default("") @map("pip_due_date")
  qaLastDate       String  @default("") @map("qa_last_date")
  /// pass | conditional | fail, or '' when never inspected.
  qaLastResult     String  @default("") @map("qa_last_result")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  codes   InnCode[]
  groups  PropertyGroupMember[]
  shellEvents ShellEvent[]
  ownerships  PropertyOwnership[]
  managements PropertyManagement[]

  @@index([status])
  @@index([marketCode])
  @@map("property")
}

/// The uniqueness ledger. One row per code ever issued, retired ones included —
/// this is what G3 checks against and what makes M5 split on history.
model InnCode {
  /// The five characters. Primary key: this IS the uniqueness guarantee (G8).
  code String @id

  propertyId String @map("property_id")

  // A snapshot of the record as issued. Deliberately denormalized: what the
  // code meant when it was issued must survive later edits to the property,
  // or a retired code stops explaining itself.
  name            String
  brandCode       String         @map("brand_code")
  brandName       String         @map("brand_name")
  chainCode       String         @map("chain_code")
  marketCode      String         @map("market_code")
  city            String
  state           String
  submarket       String         @default("")
  franchisorCode  String         @default("") @map("franchisor_code")
  status          PropertyStatus
  predecessorCode String         @default("") @map("predecessor_code")
  effectiveDate   String         @map("effective_date")
  propCode        String         @map("prop_code")

  issuedAt DateTime @default(now()) @map("issued_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@index([marketCode])
  @@map("inn_code")
}

/// A market or submarket code and the place it permanently belongs to (M6, M7).
model MarketClaim {
  /// Primary key — one claim per market code, forever (M7).
  marketCode String @id @map("market_code")

  city      String
  state     String
  /// Empty for a base market code; set for a submarket split (M5).
  submarket String @default("")
  source    MarketSource
  claimedAt String @map("claimed_at")

  /// "city|ST|submarket", set ONLY when this claim binds a specific submarket
  /// (M6 — submarket, override and registered sources). Null for a base market
  /// code, and Postgres treats nulls as distinct in a unique index, so every
  /// airport- and metro-derived claim coexists while each submarket is owned
  /// exactly once. This column replaces Firestore's submarketIndex collection.
  submarketKey String? @unique @map("submarket_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("market_claim")
}

// ───────────────────────────── Identity and access ─────────────────────────
// docs/01 §2. The whole model is three tables plus a catalog, and the shape is
// the argument: a PERSON is one row for life, a ROLE is a template, and a GRANT
// says where and when. Separating them is what makes "one login, many
// properties" and "a region is not a schema change" both fall out for free.

/// Where a grant applies. Polymorphic from day one even though only `portfolio`
/// has anything to point at yet — adding an above-property axis later must be a
/// row, never a migration (§2.2). `group` points at a PropertyGroup id.
enum Scope {
  portfolio
  group
  property
}

enum PersonStatus {
  invited /// created, has not set a password yet
  active
  suspended /// grants frozen, row intact
  offboarded /// all grants closed, row retained for audit
}

/// One row per human, org-wide, for life. A person who moves between properties
/// is the same row with different grants — never a second account.
model Person {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  /// Null until the invitation is accepted and a password is set.
  passwordHash String?      @map("password_hash")
  status       PersonStatus @default(invited)
  /// Monotonic. Bumped with every change a consumer must hear about — a grant,
  /// a status, a password (docs/01 §2.8). 0 until the person first enters the
  /// people stream.
  personVersion Int         @default(0) @map("person_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  grants       Grant[]      @relation("GrantHolder")
  events       PersonEvent[]
  grantsIssued Grant[]      @relation("GrantedBy")
  auditEvents  AuditEvent[]

  @@index([status])
  @@map("person")
}

/// A named template from a closed catalog. Lives in DATA, not a Postgres enum,
/// so adding a role is a row rather than a migration (§2.4).
model Role {
  key         String @id
  name        String
  description String

  /// Bumped when the permission set changes. Grants record the version they
  /// were issued against, so the audit trail cannot be rewritten by an edit.
  version Int @default(1)

  /// The scopes this role may be granted at. A role assignable only at
  /// `property` cannot be handed out portfolio-wide.
  assignableAt Scope[] @map("assignable_at")

  permissions RolePermission[]
  grants      Grant[]
  links       RoleLink[]

  @@map("role")
}

/// An atomic capability. `scopeMax` is the direct-bill firewall expressed as a
/// constraint rather than a discipline (§2.3): a permission capped at
/// `property` can never be attached to a role granted above one property, so
/// nobody holds A/R authority across the portfolio by accident.
model Permission {
  key      String @id
  name     String
  /// The widest scope this permission may ever be granted at.
  scopeMax Scope  @map("scope_max")
  /// Which system enforces it. The console owns the catalog; Inspire and
  /// InspiredREV consume it (§2.3, §4 step 5).
  ownedBy  String @default("console") @map("owned_by")

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleKey       String @map("role_key")
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@map("role_permission")
}

// ───────────────────────────── The role crosswalk ──────────────────────────
// docs/01 §2.7. How a console role becomes a role inside Inspire and inside
// InspiredREV, so one person and one grant reach all three apps. Seeded from
// src/auth/catalog.ts and src/auth/consumer-roles.ts by `npm run db:seed`;
// the seed refuses a crosswalk that breaks the firewall.

/// Inspire's org-wide corporate roles are `org`; everything else is held per
/// property (or, in InspiredREV, scoped by the grant it rides on).
enum ConsumerTier {
  org
  property

  @@map("consumer_tier")
}

/// A role as a consumer defines it in its own code — a mirror, not a design.
model ConsumerRole {
  /// `inspire` or `inspiredrev` — the ShellSubscriber names.
  consumer String
  /// The consumer's own role key, e.g. `gm`, `corporate_admin`, `sales`.
  key      String
  name     String
  tier     ConsumerTier
  /// The consumer's ordering. Higher is more privilege; lateral roles sit low.
  rank     Int
  /// Console permission keys this role implies downstream. A console role may
  /// only link here if it holds all of them (or the link declares why not).
  carries  String[]

  links RoleLink[]

  @@id([consumer, key])
  @@map("consumer_role")
}

/// What one console role may become in one consumer — one row per allowed
/// consumer role, exactly one of them the default. No rows means no access
/// there. A GM is `readonly` in InspiredREV by default and may be granted
/// `revenue_manager` instead; that choice is recorded on the grant.
model RoleLink {
  roleKey      String  @map("role_key")
  consumer     String
  consumerRole String  @map("consumer_role")
  /// The role a grant gets when nothing else is chosen. One per role and
  /// consumer, enforced by the seed.
  isDefault    Boolean @default(false) @map("is_default")
  /// Empty unless the link knowingly carries more than the console role holds.
  /// Then it is the reason, and every seed lists it.
  exception    String  @default("")

  role   Role         @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  target ConsumerRole @relation(fields: [consumer, consumerRole], references: [consumer, key])

  @@id([roleKey, consumer, consumerRole])
  @@index([consumer, consumerRole])
  @@map("role_link")
}

/// What one grant became in one consumer, fixed when it was issued. Written
/// for every consumer the role reaches, default or not, so the people stream
/// reads it and never has to re-derive it. Changing it is a transfer: close the
/// grant, open another (§2.5).
model GrantDownstream {
  grantId      String @map("grant_id")
  consumer     String
  consumerRole String @map("consumer_role")

  grant Grant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@id([grantId, consumer])
  @@map("grant_downstream")
}

/// Who can do what, where, and WHEN. Temporal by construction: nothing is ever
/// deleted, so "who had access on 3 March" is a query rather than an
/// investigation, and a transfer is one closed grant plus one opened (§2.5).
model Grant {
  id       String @id @default(cuid())
  personId String @map("person_id")

  scope Scope
  /// Null for `portfolio`. A group id or an inn code for the narrower scopes.
  scopeRef String? @map("scope_ref")

  roleKey String @map("role_key")
  /// The role version in force when this was issued.
  roleVersion Int @map("role_version")

  effectiveFrom DateTime  @default(now()) @map("effective_from")
  /// Null while live. Set to close a grant — the row stays.
  effectiveTo   DateTime? @map("effective_to")

  /// Null only for the sunrise grant, which no person issued.
  grantedById String? @map("granted_by_id")
  reason      String

  createdAt DateTime @default(now()) @map("created_at")

  downstream GrantDownstream[]

  person    Person  @relation("GrantHolder", fields: [personId], references: [id])
  grantedBy Person? @relation("GrantedBy", fields: [grantedById], references: [id])
  role      Role    @relation(fields: [roleKey], references: [key])

  @@index([personId, effectiveTo])
  @@index([scope, scopeRef])
  @@map("grant")
}

/// Append-only. Same shape as Inspire's and InspiredREV's audit_log: actor,
/// what happened, before/after. Every issuance, grant and revocation lands here.
model AuditEvent {
  id       String  @id @default(cuid())
  actorId  String? @map("actor_id")
  action   String
  subject  String
  detail   Json    @default("{}")
  at       DateTime @default(now())

  actor Person? @relation(fields: [actorId], references: [id])

  @@index([at])
  @@index([subject])
  @@map("audit_event")
}

// ───────────────────────────── Groups ──────────────────────────────────────
// docs/01 §2.2. The regional problem, solved by refusing to model regions.
//
// A region is not a tier in a hierarchy; it is a SET of properties somebody
// drew. Modelling it as a scope makes every redraw a migration, which is why
// the boundaries could never be settled. Modelling it as membership makes a
// redraw an edit to two rows, so the boundaries never have to be settled at
// all — they can change weekly and no grant is touched.
//
// The whole above-property axis therefore lives in DATA: `Scope` stays three
// values forever, and a new way of slicing the portfolio is a new group row,
// never a schema change. That is the invariant this pair of tables exists to
// hold.

/// A reporting label, and NOTHING more. Permission evaluation never reads it —
/// deliberately, so regional coverage can be reported without the access engine
/// ever needing to know what a region is.
enum GroupKind {
  region
  brand
  entity
  ad_hoc
  audit

  @@map("group_kind")
}

/// How membership is decided. Both modes MATERIALIZE into PropertyGroupMember —
/// a rule is a way of maintaining rows, not a substitute for them, so resolving
/// access is one shape of query no matter how a property got in.
enum MembershipMode {
  manual
  rule

  @@map("membership_mode")
}

/// A set of properties, above property and below portfolio.
///
/// `id` is a slug minted once and never changed (`grp_midwest`), because grants
/// point at it — the same discipline as a property id (G1). Renaming a group is
/// a display change; the id it was granted against survives it.
model PropertyGroup {
  id   String    @id
  kind GroupKind
  name String

  /// What this group is for. Groups grant access, so an unexplained one is an
  /// unexplained set of people's reach.
  description String @default("")

  membershipMode MembershipMode @default(manual) @map("membership_mode")

  /// Only for `rule` groups. The shape is src/groups/rules.ts — a closed
  /// vocabulary, validated before it is stored, because a rule that silently
  /// matches nothing is indistinguishable from a group nobody joined.
  ruleJson Json? @map("rule_json")

  /// When the rule last materialized. A stale timestamp on a rule group is an
  /// Oversight exception (§3.1): membership drifted from what the rule says.
  syncedAt DateTime? @map("synced_at")

  /// Archived groups drop out of the pickers but keep resolving, because a
  /// group is not how access is closed — a grant is. Nothing is deleted (§2.5).
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members PropertyGroupMember[]

  @@index([kind])
  @@index([archivedAt])
  @@map("property_group")
}

/// Membership. Keyed on the property's IMMUTABLE id, never its inn code, so a
/// rebrand cannot drop a hotel out of its region (G1, G2). Resolution reads the
/// property's CURRENT code through this row, which is what makes group coverage
/// survive a code change for free.
///
/// A property belongs to as many groups as it likes — Midwest and a PIP
/// transition group and its brand group at once. A single-parent hierarchy is
/// the rigidity that made this hard in the first place.
model PropertyGroupMember {
  groupId    String @map("group_id")
  propertyId String @map("property_id")

  /// Null for a rule-materialized row. Manual membership is attributed, because
  /// adding a property to a group widens somebody's access.
  addedById String?  @map("added_by_id")
  addedAt   DateTime @default(now()) @map("added_at")

  group    PropertyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  property Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([groupId, propertyId])
  @@index([propertyId])
  @@map("property_group_member")
}

// ───────────────────────────── The shell stream ────────────────────────────
// docs/01 §1.4. How identity leaves this app (R1) without this app ever being
// on anybody's critical path (R2).
//
// `shell_event` is a transactional outbox of CHANGE NOTICES, not of payloads:
// a row says "property X changed, now at version N". The shell itself is built
// from the property's current state at delivery time. That choice is what
// makes the stream safe to replay from zero — a consumer that replays history
// arrives at the current shell for every property, never at a stale one — and
// it means a burst of edits to one hotel delivers once.

/// One change notice. `seq` is the global order consumers acknowledge against.
model ShellEvent {
  seq          Int      @id @default(autoincrement())
  propertyId   String   @map("property_id")
  /// The property's shellVersion after this change.
  shellVersion Int      @map("shell_version")
  /// Why — `issued`, `status`, `rebrand`, `setup`, `groups`, `backfill`.
  reason       String
  createdAt    DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, seq])
  @@map("shell_event")
}

/// One people change notice (docs/01 §2.8). Same outbox discipline as
/// shell_event: a notice, not a payload — the person is built from current
/// state at delivery, so replaying from zero converges and a burst of grants
/// delivers once.
model PersonEvent {
  seq           Int      @id @default(autoincrement())
  personId      String   @map("person_id")
  personVersion Int      @map("person_version")
  /// Why — `grant`, `status`, `password`, `profile`, `backfill`.
  reason        String
  createdAt     DateTime @default(now()) @map("created_at")

  person Person @relation(fields: [personId], references: [id])

  @@index([personId, seq])
  @@map("person_event")
}

/// A system that mirrors the registry. Exactly two exist: Inspire and
/// InspiredREV (§1.4). Anything else gets the inn code as a label and nothing
/// more (§1.6).
model ShellSubscriber {
  /// `inspire`, `inspiredrev`.
  name    String  @id
  /// The consumer's receiver, e.g. https…/api/registry/v1/shell
  url     String
  /// HMAC key both sides hold. Stored plaintext because every delivery is
  /// signed with it — the same tradeoff Inspire makes for WebhookEndpoint.secret.
  secret  String
  active  Boolean @default(true)

  /// Highest shell_event.seq the consumer has acknowledged applying.
  /// Resetting it to 0 replays the whole stream; consumers ignore anything
  /// not newer than what they hold, so a replay is always safe.
  cursor  Int     @default(0)

  lastAttemptAt   DateTime? @map("last_attempt_at")
  lastDeliveredAt DateTime? @map("last_delivered_at")
  /// Empty after a clean delivery. A non-empty value is an Oversight exception.
  lastError       String    @default("") @map("last_error")

  /// The people stream (docs/01 §2.8) rides the same subscription and secret,
  /// delivered to the sibling /api/registry/v1/people receiver, with its own
  /// cursor into person_event.
  peopleCursor          Int       @default(0) @map("people_cursor")
  peopleLastAttemptAt   DateTime? @map("people_last_attempt_at")
  peopleLastDeliveredAt DateTime? @map("people_last_delivered_at")
  peopleLastError       String    @default("") @map("people_last_error")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("shell_subscriber")
}

// ───────────────────────────── Ownership and control ───────────────────────
// docs/01 §1.7. Who owns the building and who runs it.
//
// An organization is its own row because one owner or one management company
// spans many hotels. A property points at them through ASSIGNMENTS, and an
// assignment is temporal by construction, the same way a grant is: a sale or a
// change of manager closes one row and opens another, so "who managed EVVHX on
// 3 March" is a query. Nothing is deleted.
//
// The rule this exists to enforce: every MHG hotel is run by a registered
// third-party management company, never by a principal of its owner. Opening
// a hotel (pipeline → active) is refused until that holds.

enum OrgKind {
  ownership
  management

  @@map("org_kind")
}

/// An ownership group or a management company. `id` is a slug minted once
/// (`org_riverside_capital`) and never recomputed, like a group id.
model Organization {
  id   String  @id
  kind OrgKind
  name String

  legalName          String @default("") @map("legal_name")
  /// State of formation or registration.
  registeredState    String @default("") @map("registered_state")
  /// The state business-entity or licence number that makes a management
  /// company a registered third party. Required for kind `management`.
  registrationNumber String @default("") @map("registration_number")

  contactName  String @default("") @map("contact_name")
  contactEmail String @default("") @map("contact_email")
  contactPhone String @default("") @map("contact_phone")

  /// Archived organizations drop out of the pickers. An archived management
  /// company fails compliance wherever it is still assigned.
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  principals  OrganizationPrincipal[]
  ownerships  PropertyOwnership[]
  managements PropertyManagement[]

  @@index([kind])
  @@map("organization")
}

/// A person who owns or controls an organization. Deliberately NOT a Person:
/// principals are not console users, and making them rows in `person` would
/// put logins where only names belong. Compared across organizations on the
/// lowercased email, which is how "a principal of the owner may not operate
/// the hotel" is checked.
model OrganizationPrincipal {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  name           String
  /// Lowercased on write.
  email          String
  title          String @default("")

  addedById String?   @map("added_by_id")
  addedAt   DateTime  @default(now()) @map("added_at")
  /// Set to remove. The row stays so past compliance can be explained.
  removedAt DateTime? @map("removed_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, removedAt])
  @@index([email])
  @@map("organization_principal")
}

/// Who owns the building, and when. One live row (effectiveTo null) per
/// property, kept by the service in a transaction: assigning a new owner
/// closes the current row on the new row's start date.
model PropertyOwnership {
  id             String @id @default(cuid())
  propertyId     String @map("property_id")
  organizationId String @map("organization_id")

  /// The single-asset entity on the deed, which is usually not the group.
  titleEntity      String @default("") @map("title_entity")
  titleEntityState String @default("") @map("title_entity_state")

  /// The MHG licence agreement with the owner. YYYY-MM-DD, or ''.
  licenseEffectiveDate String @default("") @map("license_effective_date")
  licenseExpiryDate    String @default("") @map("license_expiry_date")

  /// YYYY-MM-DD, held as strings like effectiveDate so no zone can shift them.
  effectiveFrom String  @map("effective_from")
  effectiveTo   String? @map("effective_to")

  assignedById String?  @map("assigned_by_id")
  reason       String
  createdAt    DateTime @default(now()) @map("created_at")

  property     Property     @relation(fields: [propertyId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([propertyId, effectiveTo])
  @@index([organizationId])
  @@map("property_ownership")
}

/// Who runs the hotel, and when. Same temporal shape as ownership. The
/// management agreement's term rides on the assignment because the agreement
/// and the assignment begin and end together.
model PropertyManagement {
  id             String @id @default(cuid())
  propertyId     String @map("property_id")
  organizationId String @map("organization_id")

  agreementExpiryDate   String @default("") @map("agreement_expiry_date")
  terminationNoticeDays Int?   @map("termination_notice_days")

  effectiveFrom String  @map("effective_from")
  effectiveTo   String? @map("effective_to")

  assignedById String?  @map("assigned_by_id")
  reason       String
  createdAt    DateTime @default(now()) @map("created_at")

  property     Property     @relation(fields: [propertyId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([propertyId, effectiveTo])
  @@index([organizationId])
  @@map("property_management")
}
